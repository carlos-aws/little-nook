; Little Nook — open this file in Godot, then press F6 or F5.
config_version=5

[application]
config/name="Little Nook"
config/description="A little learning. A little care. A home to grow into."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/icon.svg"
boot_splash/image="res://assets/art/splash.png"
boot_splash/bg_color=Color(0.98, 0.96, 0.92, 1)
boot_splash/fullsize=false
config/use_custom_user_dir=true
config/custom_user_dir_name="Little Nook"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.98, 0.96, 0.92, 1)

[audio]
driver/enable_input=false
general/text_to_speech=true

[input_devices]
pointing/emulate_mouse_from_touch=true
